# HTTP -- serve directly for ArvanCloud Flexible SSL mode
server {
    listen 80;
    listen [::]:80;
    server_name safhenokhost.ir www.safhenokhost.ir;
    root /var/www/customer-site/public;
    index index.php;
    include snippets/origin-diagnostic-access.conf;

    set_real_ip_from 185.143.232.0/22;
    set_real_ip_from 188.229.116.16/30;
    set_real_ip_from 94.101.182.0/27;
    set_real_ip_from 2.144.3.128/28;
    set_real_ip_from 37.32.16.0/27;
    set_real_ip_from 37.32.17.0/27;
    set_real_ip_from 37.32.18.0/27;
    set_real_ip_from 37.32.19.0/27;
    set_real_ip_from 185.215.232.0/22;
    set_real_ip_from 178.131.120.48/28;
    set_real_ip_from 94.101.183.0/28;
    set_real_ip_from 78.157.36.112/28;
    set_real_ip_from 95.38.61.80/28;
    real_ip_header Ar-Real-Ip;
    real_ip_recursive on;

    location / {
        try_files $uri $uri/ /index.php?$query_string;
    }

    location ~ \.php$ {
        fastcgi_pass unix:/run/php/php8.3-fpm.sock;
        fastcgi_param SCRIPT_FILENAME $realpath_root$fastcgi_script_name;
        fastcgi_param HTTPS $forwarded_https;
        include fastcgi_params;
        fastcgi_read_timeout 120;
    }

    location ~ /\.ht { deny all; }
    client_max_body_size 25M;
    gzip on;
    gzip_types text/plain text/css application/json application/javascript text/xml;
}

# HTTPS -- for ArvanCloud Full SSL mode
server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name safhenokhost.ir www.safhenokhost.ir;
    root /var/www/customer-site/public;
    index index.php;
    include snippets/origin-diagnostic-access.conf;

    set_real_ip_from 185.143.232.0/22;
    set_real_ip_from 188.229.116.16/30;
    set_real_ip_from 94.101.182.0/27;
    set_real_ip_from 2.144.3.128/28;
    set_real_ip_from 37.32.16.0/27;
    set_real_ip_from 37.32.17.0/27;
    set_real_ip_from 37.32.18.0/27;
    set_real_ip_from 37.32.19.0/27;
    set_real_ip_from 185.215.232.0/22;
    set_real_ip_from 178.131.120.48/28;
    set_real_ip_from 94.101.183.0/28;
    set_real_ip_from 78.157.36.112/28;
    set_real_ip_from 95.38.61.80/28;
    real_ip_header Ar-Real-Ip;
    real_ip_recursive on;

    ssl_certificate     /etc/ssl/safhenokhost/safhenokhost.crt;
    ssl_certificate_key /etc/ssl/safhenokhost/safhenokhost.key;
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_ciphers         HIGH:!aNULL:!MD5;

    add_header X-Frame-Options "SAMEORIGIN";
    add_header X-Content-Type-Options "nosniff";
    add_header Strict-Transport-Security "max-age=31536000" always;

    location / {
        try_files $uri $uri/ /index.php?$query_string;
    }

    location ~ \.php$ {
        fastcgi_pass unix:/run/php/php8.3-fpm.sock;
        fastcgi_param SCRIPT_FILENAME $realpath_root$fastcgi_script_name;
        include fastcgi_params;
        fastcgi_read_timeout 120;
    }

    location ~ /\.ht { deny all; }
    client_max_body_size 25M;
    gzip on;
    gzip_types text/plain text/css application/json application/javascript text/xml;
}
