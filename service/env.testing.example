# Database Safety Hardening (Phase S1): tracked template for the local,
# gitignored service/.env.testing file.
#
# This repo's root .gitignore has a deliberate, explicit,
# already-commented policy: `.env` / `.env.*` / `!.env.example` —
# "Never commit real credentials or local env files from anywhere in the
# repo." service/.env.testing matches `.env.*` and is correctly ignored
# by that rule, same as this file would be if it were also named
# `.env.testing.example` (verified directly with `git check-ignore`) —
# hence the deliberately different name here, with no leading dot, so it
# can be tracked without touching that policy at all.
#
# `composer setup` copies this into place automatically (mirroring the
# exact same pattern already used for .env/.env.example) — see
# composer.json's "setup" script. To do it manually:
#   cp env.testing.example .env.testing
# then generate your OWN dedicated APP_KEY for it (never reuse the real
# .env's key, and never reuse the placeholder below verbatim in a real
# checkout — it exists only so a fresh git clone has SOMETHING valid to
# boot encryption with before you generate your own):
#   php -r "echo 'APP_KEY=base64:' . base64_encode(random_bytes(32));"
#
# Without this file existing as service/.env.testing, `php artisan
# <command> --env=testing` (or even a plain PHPUnit run with
# APP_ENV=testing already set in the process environment — see
# LoadEnvironmentVariables::checkForSpecificEnvironmentFile(), which
# prefers .env.{APP_ENV} whenever that file exists, not just on an
# explicit --env CLI flag) silently falls back to the normal .env — real
# APP_ENV, real DB_DATABASE, the real development database. That silent
# fallback is exactly what let `migrate:fresh --env=testing` wipe
# service/database/database.sqlite once already.
#
# Once Laravel resolves service/.env.testing as authoritative for a
# testing run, it does not also fall back to .env for anything else —
# confirmed the hard way while building this: an earlier, sparser
# version of this file broke every test touching an 'encrypted' Eloquent
# cast (missing APP_KEY) and one test that specifically requires
# APP_DEBUG=true, until this was made a full mirror of .env's own
# (non-secret) values with only the deliberately-different testing keys
# changed below. Keep it that way — do not trim entries "because they
# look redundant with phpunit.xml"; phpunit.xml's <env> block only
# protects the keys it explicitly lists, every other key comes from
# whichever .env file actually loads.
#
# This is NOT the only safeguard, and must not be treated as one: a bare
# `php artisan migrate:fresh` (no APP_ENV=testing in the environment at
# all) never consults this file either — Laravel only prefers
# .env.testing when APP_ENV already resolves to 'testing' from
# somewhere. The actual, unconditional fail-closed guarantee is
# DestructiveCommandGuard (see app/Support/Database/ and
# app/Console/Commands/DatabaseSafety/), which checks the final resolved
# runtime environment/connection/path regardless of which .env file
# produced them, and cannot be bypassed by --env or --force (verified by
# direct subprocess testing).
#
# No secrets here either way: every value below mirrors .env's own
# already-non-secret defaults (empty AWS credentials, local log-based
# mail, localhost redis/memcached hosts never actually contacted in a
# sqlite :memory: test run).

APP_NAME=Laravel
APP_ENV=testing
APP_KEY=base64:lQ6VFBCBHyrzKTk/nL4LUwEh8BnnG+MN2QLOWAq4DOs=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=4

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
DB_DATABASE=:memory:
DB_URL=

SESSION_DRIVER=array
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=null
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=array

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=array
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

PULSE_ENABLED=false
TELESCOPE_ENABLED=false
NIGHTWATCH_ENABLED=false
