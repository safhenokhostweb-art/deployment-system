#!/usr/bin/env bash
# Root-owned, intentionally non-generic runtime permission normalizer.
set -Eeuo pipefail

[ "$#" -eq 1 ] || exit 64
case "$1" in
  deployment-system)
    ROOT=/var/www/deployment-system/service
    paths=("$ROOT/storage" "$ROOT/bootstrap/cache" "$ROOT/database")
    files=("$ROOT/database/database.sqlite")
    ;;
  saas-platform)
    ROOT=/var/www/saas-platform
    # public/storage is a real runtime data directory for this application,
    # not Laravel's usual storage symlink. It must remain writable after the
    # artifact activation copies it into the new release.
    paths=("$ROOT/storage" "$ROOT/bootstrap/cache" "$ROOT/public/storage")
    files=()
    ;;
  *) exit 65 ;;
esac

for path in "${paths[@]}" "${files[@]}"; do
  resolved="$(realpath -e -- "$path")" || exit 66
  case "$resolved" in "$ROOT"/*) ;; *) exit 67 ;; esac
done

for path in "${paths[@]}"; do
  find -P "$path" -type d -exec chown www-data:www-data {} + -exec chmod 0775 {} +
  find -P "$path" -type f -exec chown www-data:www-data {} + -exec chmod 0664 {} +
done

for path in "${files[@]}"; do
  [ -f "$path" ] || exit 68
  chown www-data:www-data "$path"
  chmod 0664 "$path"
done
