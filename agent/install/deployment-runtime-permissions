#!/usr/bin/env bash
# Root-owned, intentionally non-generic runtime permission normalizer.
set -Eeuo pipefail

fail() {
  printf 'deployment-runtime-permissions: project=%s phase=%s path=%s operation=%s exit_code=%s\n' "$1" "$2" "$3" "$4" "$5" >&2
  exit "$5"
}

project_key="${1:-missing}"
[ "$#" -eq 1 ] || fail "$project_key" validate - 'argument count' 64
OWNER=www-data
GROUP=www-data
DIRECTORY_MODE=0775
FILE_MODE=0664
writable_paths=()
case "$project_key" in
  deployment-system)
    ROOT=/var/www/deployment-system/service
    # Persistent state lives OUTSIDE the swappable release — a sibling
    # directory the artifact flow references via symlink, never copies
    # (see ArtifactManager::preparePersistentReferences). It holds the
    # real runtime data and must stay www-data-writable across every
    # release swap, so this helper normalizes it exactly like the
    # in-release runtime directories.
    PERSISTENT_ROOT=/var/www/deployment-system/persistent
    paths=("$ROOT/storage" "$ROOT/bootstrap/cache" "$ROOT/database" "$PERSISTENT_ROOT")
    files=("$ROOT/database/database.sqlite")
    ;;
  saas-platform)
    ROOT=/var/www/saas-platform
    # public/storage is a real runtime data directory for this application,
    # not Laravel's usual storage symlink. It must remain writable after the
    # artifact activation copies it into the new release.
    paths=("$ROOT/storage" "$ROOT/bootstrap/cache" "$ROOT/public/storage")
    files=()
    ;;
  customer-site)
    ROOT=/var/www/customer-site
    PERSISTENT_ROOT=/var/www/customer-site-shared
    UPLOADS_ROOT="$PERSISTENT_ROOT/uploads"
    OWNER=deployment-agent
    GROUP=www-data
    DIRECTORY_MODE=2775
    FILE_MODE=0664
    # Bootstrap is intentionally idempotent. install -d reuses an existing
    # directory, never clears it, and fixes only the approved directory
    # entries before the confined recursive normalization below.
    [ ! -L "$PERSISTENT_ROOT" ] || fail "$project_key" validate "$PERSISTENT_ROOT" 'shared root must not be a symlink' 67
    [ ! -L "$UPLOADS_ROOT" ] || fail "$project_key" validate "$UPLOADS_ROOT" 'uploads root must not be a symlink' 67
    install -d -o "$OWNER" -g "$GROUP" -m "$DIRECTORY_MODE" "$PERSISTENT_ROOT" "$UPLOADS_ROOT" \
      || fail "$project_key" prepare "$UPLOADS_ROOT" 'install persistent uploads root' 69
    # The release is immutable except for Laravel's explicit runtime paths.
    # Keep this list narrow: application source, vendor, and public assets are
    # deliberately excluded. Missing entries fail closed instead of allowing
    # a release that PHP-FPM cannot log/cache from to become healthy.
    paths=(
      "$UPLOADS_ROOT"
      "$ROOT/storage/logs"
      "$ROOT/storage/framework/cache"
      "$ROOT/storage/framework/sessions"
      "$ROOT/storage/framework/views"
      "$ROOT/bootstrap/cache"
    )
    writable_paths=(
      "$ROOT/storage/logs"
      "$ROOT/storage/framework/cache"
      "$ROOT/storage/framework/sessions"
      "$ROOT/storage/framework/views"
      "$ROOT/bootstrap/cache"
    )
    files=()
    ;;
  *) fail "$project_key" validate - 'invalid project key' 65 ;;
esac

# The find child processes use the same concise diagnostic format for
# persistent chown/chmod failures. A vanished entry remains the one tolerated
# race: it is absent when the child reaches it, so no failure is reported.
export -f fail
export project_key OWNER GROUP DIRECTORY_MODE FILE_MODE

validate_path() {
  local path="$1"
  resolved="$(realpath -e -- "$path")" || fail "$project_key" validate "$path" realpath 66
  case "$resolved" in "$ROOT"/*) return 0 ;; esac
  # A configured persistent root is the one approved path family OUTSIDE the
  # release tree (sibling of the working directory, symlinked into each
  # release — never copied). Its own confinement keeps persistent state from
  # ever being reached through a broader path. Empty for projects with no
  # persistent configuration, in which case only $ROOT confinement applies.
  if [ -n "${PERSISTENT_ROOT:-}" ]; then
    case "$resolved" in "$PERSISTENT_ROOT"|"$PERSISTENT_ROOT"/*) return 0 ;; esac
  fi
  fail "$project_key" validate "$path" 'path confinement' 67
}

for path in "${paths[@]}"; do
  validate_path "$path"
done

for path in "${files[@]}"; do
  [ -f "$path" ] || fail "$project_key" validate "$path" 'required database.sqlite existence check' 68
  validate_path "$path"
done

for path in "${paths[@]}"; do
  # Runtime files (notably SQLite WAL/SHM/journal files and session/cache
  # entries) can disappear between readdir and chown.  Ignore only that
  # legitimate race; any persistent ownership/mode failure remains fatal.
  find -P "$path" -ignore_readdir_race -type d -exec /bin/bash -c '
    for target do
      chown "$OWNER:$GROUP" -- "$target" 2>/dev/null || { [ ! -e "$target" ] || fail "$project_key" normalize "$target" chown 1; }
      chmod "$DIRECTORY_MODE" -- "$target" 2>/dev/null || { [ ! -e "$target" ] || fail "$project_key" normalize "$target" chmod 1; }
    done
  ' bash {} + || fail "$project_key" normalize "$path" 'find directory' 1
  find -P "$path" -ignore_readdir_race -type f -exec /bin/bash -c '
    for target do
      chown "$OWNER:$GROUP" -- "$target" 2>/dev/null || { [ ! -e "$target" ] || fail "$project_key" normalize "$target" chown 1; }
      chmod "$FILE_MODE" -- "$target" 2>/dev/null || { [ ! -e "$target" ] || fail "$project_key" normalize "$target" chmod 1; }
    done
  ' bash {} + || fail "$project_key" normalize "$path" 'find file' 1
done

# Verify effective access as the real PHP-FPM account after normalization,
# not merely the mode bits observed by root. This catches missing group
# membership, ACLs, or a read-only mount before success can be reported.
for path in "${writable_paths[@]}"; do
  runuser -u www-data -- test -w "$path" \
    || fail "$project_key" verify "$path" 'www-data write access' 70
done

if [ "$project_key" = customer-site ]; then
  # Prove the inverse side of the contract too: PHP-FPM may write only the
  # five approved Laravel runtime trees. -P never follows public/uploads or
  # any other symlink, and pruning excludes the approved subtrees themselves.
  unexpected_writable="$({
    runuser -u www-data -- find -P "$ROOT" \
      \( -path "$ROOT/storage/logs" \
         -o -path "$ROOT/storage/framework/cache" \
         -o -path "$ROOT/storage/framework/sessions" \
         -o -path "$ROOT/storage/framework/views" \
         -o -path "$ROOT/bootstrap/cache" \) -prune \
      -o \( -type d -o -type f \) -writable -print -quit
  } 2>/dev/null)" || fail "$project_key" verify "$ROOT" 'source-tree write scan' 71
  [ -z "$unexpected_writable" ] \
    || fail "$project_key" verify "$unexpected_writable" 'unapproved www-data write access' 72
fi

for path in "${files[@]}"; do
  [ -f "$path" ] || fail "$project_key" normalize "$path" 'required database.sqlite existence check' 68
  chown "$OWNER:$GROUP" "$path" || fail "$project_key" normalize "$path" chown 1
  chmod "$FILE_MODE" "$path" || fail "$project_key" normalize "$path" chmod 1
done
