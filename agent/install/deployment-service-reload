#!/usr/bin/env bash
# Root-owned, fixed-function helper. Its literal project arguments are also
# enforced by sudoers; no user-controlled service or Supervisor program reaches
# a privileged command.
set -Eeuo pipefail

if [ "$#" -ne 1 ]; then
    exit 64
fi

# Application releases do not change PHP-FPM configuration, and production
# OPcache validates timestamps, so reloading the shared PHP-FPM service here
# only interrupts unrelated in-flight requests. Nginx is different: an
# operator may legitimately change its configuration between deployments.
# Hash the fully expanded, syntax-checked configuration and reload only after
# a real change. The first invocation establishes a baseline without touching
# the running service.
NGINX_STATE_DIR=/var/lib/deployment-agent
NGINX_STATE_FILE="$NGINX_STATE_DIR/nginx-config.sha256"
NGINX_LOCK_FILE="$NGINX_STATE_DIR/nginx-config.lock"

persist_nginx_hash() {
    local hash="$1" temporary
    temporary="$(/usr/bin/mktemp "${NGINX_STATE_FILE}.tmp.XXXXXX")"
    printf '%s\n' "$hash" > "$temporary"
    /bin/chmod 0644 "$temporary"
    /bin/mv -f -- "$temporary" "$NGINX_STATE_FILE"
}

reload_nginx_if_config_changed() {
    local current_hash previous_hash

    /usr/bin/install -d -o root -g root -m 0755 "$NGINX_STATE_DIR"
    exec 9>"$NGINX_LOCK_FILE"
    /usr/bin/flock -x 9

    current_hash="$(/usr/sbin/nginx -T 2>/dev/null | /usr/bin/sha256sum)"
    current_hash="${current_hash%% *}"

    if [ ! -r "$NGINX_STATE_FILE" ]; then
        persist_nginx_hash "$current_hash"
        return 0
    fi

    read -r previous_hash < "$NGINX_STATE_FILE"
    if [ "$current_hash" = "$previous_hash" ]; then
        return 0
    fi

    /usr/bin/systemctl reload nginx
    persist_nginx_hash "$current_hash"
}

case "$1" in
    deployment-system)
        reload_nginx_if_config_changed
        # The activated release's queue workers must load the new code.
        # Workers are long-running processes that keep their old bytecode
        # until restarted, so `artisan queue:restart` alone (soft signal
        # after the current job) is not enough for an immediate swap —
        # restart the exact supervisor group selector.
        /usr/bin/supervisorctl restart 'deployment-service-worker:*'
        ;;
    saas-platform)
        reload_nginx_if_config_changed

        # These programs are intentionally always-on. Restart only their
        # exact allowlisted names so the activated release is loaded.
        /usr/bin/supervisorctl restart reverb
        /usr/bin/supervisorctl restart 'saas-platform-worker:*'
        /usr/bin/supervisorctl restart 'saas-install-worker:*'

        # restore is on-demand (autostart=false). A deployment must never
        # start it. Supervisor exposes it as a group, so status can contain
        # one line per process and must use the fixed group selector.
        restore_status="$(/usr/bin/supervisorctl status 'saas-restore-worker:*' 2>&1)" || true
        restore_member_count=0
        restore_running=false
        while read -r restore_program restore_state _; do
            [ -n "$restore_program" ] || continue
            case "$restore_program" in
                saas-restore-worker:*) ;;
                *)
                    echo "Could not determine saas-restore-worker state" >&2
                    exit 70
                    ;;
            esac
            restore_member_count=$((restore_member_count + 1))
            case "$restore_state" in
                RUNNING) restore_running=true ;;
                STOPPED|EXITED|FATAL|BACKOFF) ;;
                *)
                    echo "Unexpected saas-restore-worker state: $restore_state" >&2
                    exit 70
                    ;;
            esac
        done <<< "$restore_status"
        if [ "$restore_member_count" -eq 0 ]; then
            echo "Could not determine saas-restore-worker state" >&2
            exit 70
        fi
        if [ "$restore_running" = true ]; then
            /usr/bin/supervisorctl restart 'saas-restore-worker:*'
        fi
        ;;
    *)
        echo "deployment-service-reload accepts only approved project keys" >&2
        exit 65
        ;;
esac
