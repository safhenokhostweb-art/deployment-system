<?xml version="1.0" encoding="UTF-8"?>
<Task version="1.2" xmlns="http://schemas.microsoft.com/windows/2004/02/mit/task">
  <RegistrationInfo>
    <Description>Local Development Publisher Agent — polls the Deployment Hub and watches mapped project folders. Outbound HTTPS only, no inbound access required.</Description>
  </RegistrationInfo>
  <Triggers>
    <!-- Startup: Windows Login -> Local Agent Start -> Heartbeat (spec section 8) -->
    <LogonTrigger>
      <Enabled>true</Enabled>
      <!-- CHANGE_ME: the Windows account that owns the project checkouts (and their git credentials/SSH keys) -->
      <UserId>CHANGE_ME_WINDOWS_USER</UserId>
      <Delay>PT30S</Delay>
    </LogonTrigger>
  </Triggers>
  <Principals>
    <Principal id="Author">
      <UserId>CHANGE_ME_WINDOWS_USER</UserId>
      <LogonType>InteractiveToken</LogonType>
      <RunLevel>LeastPrivilege</RunLevel>
    </Principal>
  </Principals>
  <Settings>
    <MultipleInstancesPolicy>IgnoreNew</MultipleInstancesPolicy>
    <DisallowStartIfOnBatteries>false</DisallowStartIfOnBatteries>
    <StopIfGoingOnBatteries>false</StopIfGoingOnBatteries>
    <StartWhenAvailable>true</StartWhenAvailable>
    <RunOnlyIfNetworkAvailable>false</RunOnlyIfNetworkAvailable>
    <AllowHardTerminate>true</AllowHardTerminate>
    <ExecutionTimeLimit>PT0S</ExecutionTimeLimit>
    <Priority>7</Priority>
    <RestartOnFailure>
      <Interval>PT1M</Interval>
      <Count>999</Count>
    </RestartOnFailure>
  </Settings>
  <Actions Context="Author">
    <Exec>
      <!-- CHANGE_ME: absolute path to php.exe -->
      <Command>CHANGE_ME_PHP_EXE</Command>
      <!-- CHANGE_ME: absolute path to this local-agent/agent.php -->
      <Arguments>"CHANGE_ME_AGENT_PHP"</Arguments>
      <!-- CHANGE_ME: this local-agent/ directory -->
      <WorkingDirectory>CHANGE_ME_LOCAL_AGENT_DIR</WorkingDirectory>
    </Exec>
  </Actions>
</Task>
