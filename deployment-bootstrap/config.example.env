# نسخه نمونه فایل تنظیمات One-Click Deployment Bootstrap.
#
# این فایل را کپی کنید:
#   cp config.example.env config.env
# سپس مقادیر زیر را با اطلاعات واقعی سرور خودتان جایگزین کنید.
#
# هیچ Secret واقعی داخل این فایل یا نسخه Git آن قرار نگیرد — تنها مقدار
# حساسی که اینجا وارد می‌شود GITHUB_TOKEN است (اختیاری)؛ بقیه Secretها
# (Agent Token، Signing Secret، Webhook Secret) در همان اجرای اول توسط
# «php artisan deployment:bootstrap» و با رمزنگاری امن ساخته می‌شوند.

# آدرس عمومی پنل Deployment Hub (باید HTTPS باشد)
DEPLOYMENT_PANEL_URL=https://deployment.safhenokhost.ir

# مسیر نصب همین پنل روی این سرور (جایی که install.sh از آن
# «php artisan deployment:bootstrap» را اجرا می‌کند)
DEPLOYMENT_APP_PATH=/var/www/deployment-system/service

# مسیر ریشه Repository (جایی که git واقعی قرار دارد) و مسیر Laravel
# پروژه‌ای که قرار است به‌صورت خودکار Deploy شود — می‌تواند همان پنل
# باشد (حالت Self-Hosted) یا یک پروژه کاملاً جدا
REPOSITORY_PATH=/var/www/deployment-system
LARAVEL_PATH=/var/www/deployment-system/service

# سرور
SERVER_NAME="سرور اصلی Deployment System"
SERVER_IP=87.107.12.81

# Agent
AGENT_NAME="عامل اصلی Deployment System"

# پروژه و Repository
PROJECT_NAME="Deployment System"
PROJECT_KEY=deployment-system
REPOSITORY_SSH_URL=git@github.com:safhenokhostweb-art/deployment-system.git
REPOSITORY_HTTPS_URL=https://github.com/safhenokhostweb-art/deployment-system.git
GITHUB_OWNER=safhenokhostweb-art
GITHUB_REPOSITORY=deployment-system
DEPLOY_BRANCH=master

# Environment
ENVIRONMENT_NAME=Production
ENVIRONMENT_KEY=production

# Deployment Target
TARGET_NAME="سرور اصلی Production"
TARGET_PATH=/var/www/deployment-system
TARGET_LARAVEL_PATH=/var/www/deployment-system/service

# محیط اجرا روی سرور
PHP_BINARY=/usr/bin/php8.3
PHP_FPM_SERVICE=php8.3-fpm
WEB_SERVER_SERVICE=nginx

# اگر سرور فعلاً محدودیت شبکه به Packagist دارد این را false نگه دارید؛
# هر وقت composer install روی همین سرور مطمئن شد، به true تغییر دهید و
# install.sh را دوباره اجرا کنید (idempotent است، رکورد تکراری نمی‌سازد)
RUN_COMPOSER_INSTALL=false

# اختیاری: یک GitHub Personal Access Token از نوع Fine-grained، فقط با
# دسترسی Read/Write روی "Webhooks" همین Repository (هیچ دسترسی دیگری
# لازم نیست). اگر خالی بماند، نصب شکست نمی‌خورد — فقط باید Webhook را
# دستی در GitHub اضافه کنید (install.sh آدرس و Secret را یک‌بار نمایش
# می‌دهد).
GITHUB_TOKEN=

# فقط وقتی true کنید که GITHUB_TOKEN را هم تنظیم کرده باشید
AUTO_CREATE_GITHUB_WEBHOOK=false
